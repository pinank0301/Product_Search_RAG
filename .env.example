# Cloudflare Workers AI Credentials
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Model Endpoints
CLOUDFLARE_TEXT_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
CLOUDFLARE_GUARD_MODEL=@cf/meta/llama-guard-3-8b

# NeonDB PostgreSQL Connection String with pgvector
# Example: postgresql://username:password@ep-cold-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=

# Local CLIP model
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

